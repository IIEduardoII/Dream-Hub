# Configurações de Conexão com o Dispositivo Servidor (Termux / SSH)
# Copie este arquivo para .env e preencha com os dados do seu dispositivo
PHONE_HOST=100.x.y.z       # IP Tailscale do seu dispositivo servidor
PHONE_PORT=8022            # Porta do SSH no Termux (padrão: 8022)
PHONE_USER=u0_a000         # Nome do usuário no Termux (descubra com o comando 'whoami')
PHONE_PASS=sua_senha_aqui  # Senha configurada no Termux (comando 'passwd')
