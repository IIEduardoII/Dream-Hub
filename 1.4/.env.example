# Configurações de SSH / Tailscale (Dispositivo Servidor Termux)
# Copie este arquivo para .env e preencha com seus dados reais
TERMUX_HOST=100.x.y.z
TERMUX_PORT=8022
TERMUX_USER=u0_a000
TERMUX_PASS=sua_senha_aqui

# Variáveis para Domínio Gratuito + HTTPS Oficial (DuckDNS + Let's Encrypt DNS-01)
DUCKDNS_DOMAIN=seu-subdominio.duckdns.org
DUCKDNS_TOKEN=cole_seu_token_do_duckdns_aqui
